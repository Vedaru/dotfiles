/* Dark Brown Rofi Theme - Rofi 1.7.3 */

/*****----- Configuration -----*****/
configuration {
    modi:                       "drun,window";
    show-icons:                 true;
    icon-theme:                 "Adwaita";
    display-drun:               "Apps";
    display-window:             "Windows";
    drun-display-format:        "{name}";
    window-format:              "{w}  {c} — {t}";
    sorting-method:             "fzf";
    sort:                       true;
}

/*****----- Dark Brown palette -----*****/
* {
    font:                        "0xProto Nerd Font 10";

    /* surfaces */
    surface:                     #1A1008;
    surface-container:           #241A10;
    surface-container-high:      #2E2215;
    surface-container-highest:   #3A2D1D;

    /* text */
    on-surface:                  #E8D5B8;
    on-surface-variant:          #B89E7A;

    /* accent */
    primary:                     #A0714A;
    on-primary:                  #1A1008;
    primary-container:           #3E2A18;
    on-primary-container:        #E8C9A8;

    urgent:                      #C06040;
    on-urgent:                   #1A0808;

    /* aliases */
    background:                  @surface;
    background-alt:              @surface-container-high;
    foreground:                  @on-surface;
    selected:                    @primary-container;
    active:                      @primary;
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       560px;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    border-radius:               12px;
    cursor:                      "default";
    background-color:            @surface;
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     10px;
    padding:                     16px;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "inputbar", "message", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     8px;
    padding:                     10px 14px;
    border-radius:               8px;
    background-color:            @surface-container-high;
    text-color:                  @on-surface;
    children:                    [ "textbox-prompt-colon", "entry" ];
}
textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         " ";
    background-color:            inherit;
    text-color:                  @primary;
}
entry {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "Search...";
    placeholder-color:           @on-surface-variant;
}

/*****----- Mode Switcher -----*****/
mode-switcher{
    enabled:                     true;
    spacing:                     8px;
    background-color:            transparent;
    text-color:                  @on-surface;
}
button {
    padding:                     8px 12px;
    border-radius:               6px;
    background-color:            @surface-container-high;
    text-color:                  @on-surface-variant;
    cursor:                      pointer;
}
button selected {
    background-color:            @primary;
    text-color:                  @on-primary;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;

    spacing:                     4px;
    background-color:            transparent;
    text-color:                  @on-surface;
    cursor:                      "default";
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     12px;
    padding:                     8px 12px;
    border-radius:               8px;
    background-color:            transparent;
    text-color:                  @on-surface;
    cursor:                      pointer;
}
element normal.normal {
    background-color:            inherit;
    text-color:                  inherit;
}
element normal.urgent {
    background-color:            transparent;
    text-color:                  @urgent;
}
element normal.active {
    background-color:            @surface-container-high;
    text-color:                  @primary;
}
element selected.normal {
    background-color:            @primary-container;
    text-color:                  @on-primary-container;
}
element selected.urgent {
    background-color:            @urgent;
    text-color:                  @on-urgent;
}
element selected.active {
    background-color:            @primary-container;
    text-color:                  @on-primary-container;
}
element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        24px;
    cursor:                      inherit;
}
element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

/*****----- Message -----*****/
message {
    background-color:            transparent;
}
textbox {
    padding:                     10px 14px;
    border-radius:               8px;
    background-color:            @surface-container;
    text-color:                  @on-surface-variant;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
error-message {
    padding:                     12px;
    border-radius:               8px;
    background-color:            @surface-container;
    text-color:                  @on-surface;
}
